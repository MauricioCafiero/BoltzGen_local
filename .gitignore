# BoltzGen's own source: fetched and patched by setup.sh, never committed here
src_boltzgen/

.venv/
workbench/
*.log
__pycache__/
scratch/

# MD working trees. Trajectories are gigabytes, so they stay local; the scripts, the prepared
# inputs and the MM/GBSA results are small and are kept. Excluding the directories outright
# would have thrown away FINAL_RESULTS_MMPBSA.dat, which is the actual result.
*.dcd
*.xtc
*.nc
*.chk
*.prmtop
*.inpcrd
md/*/system/
md/inputs/
# MMPBSA.py writes its scratch into the working directory
_MMPBSA_*
# sander/MMPBSA byproducts written into the working directory. reference.frc is a per-atom
# force dump and reached 6 GB from one 20 ns window; it is regenerated by any MMPBSA run.
*.frc
mdinfo
