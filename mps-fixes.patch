diff --git a/src/boltzgen/data/mol.py b/src/boltzgen/data/mol.py
index 5fbe365..36139e1 100755
--- a/src/boltzgen/data/mol.py
+++ b/src/boltzgen/data/mol.py
@@ -8,9 +8,16 @@ import zipfile
 
 import numpy as np
 import torch
+from rdkit import Chem
 from rdkit.Chem import Mol, AllChem
 from tqdm import tqdm
 
+# RDKit does not pickle atom properties by default, and every molecule here carries the
+# per-atom "name" the featurizer looks up. Where DataLoader workers start with "spawn"
+# rather than "fork" -- the default on macOS -- the dataset is pickled into each worker
+# and those names are silently lost, so the first batch dies with KeyError: 'name'.
+Chem.SetDefaultPickleProperties(Chem.PropertyPickleOptions.AllProps)
+
 from boltzgen.data import const
 from boltzgen.data.pad import pad_dim
 from boltzgen.model.loss.confidence import lddt_dist
